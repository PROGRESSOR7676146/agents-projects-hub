diff --git a/src/kernel/contracts/protected-permission.ts b/src/kernel/contracts/protected-permission.ts
new file mode 100644
--- /dev/null
+++ b/src/kernel/contracts/protected-permission.ts
@@ -0,0 +1,43 @@
+// Additive, private Hub permission channel. The public IMAdapter is unchanged.
+import type { IMAdapter, OutgoingMessage } from './im-adapter.js';
+
+export interface ProtectedCallback {
+  callbackId: string;
+  userId: string;
+  isBot: boolean;
+  chatId: string;
+  chatType: string;
+  messageId: string;
+  data: string;
+}
+
+export interface ProtectedTelegram extends IMAdapter {
+  onProtectedCallback(handler: ((event: ProtectedCallback) => void) | null): void;
