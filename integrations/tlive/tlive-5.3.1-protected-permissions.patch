+/** Bounded read-only native Codex card evidence. No control capability or payload. */
+export interface ApprovalSnapshot {
+  kind: 'approval.snapshot'; version: 1; epoch: string; epochStartedAt: number; capturedAt: number; truncated: boolean;
+  entries: Array<{ threadId: string; turnId?: string; providerRequestId: string | number; itemId: string;
