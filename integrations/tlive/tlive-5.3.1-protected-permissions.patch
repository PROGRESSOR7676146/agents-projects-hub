+  private onCallback(event: ProtectedCallback): void {
+    if (this.#closed || !event || typeof event.data !== 'string') return;
+    const match = /^hp:([0-9a-f-]{36}):([adb])$/.exec(event.data);
+    if (!match || !UUID.test(match[1])) return;
+    const entry = this.#pending.get(match[1]);
+    if (!entry || entry.binding.expiresAt <= Date.now() || !entry.messageId
+      || event.isBot !== false || event.userId !== this.cfg.ownerId
+      || event.chatId !== this.cfg.chatId || event.chatType !== 'private'
+      || event.messageId !== entry.messageId || typeof event.callbackId !== 'string'
+      || event.callbackId.length < 1 || event.callbackId.length > 200) return;
+    if (match[2] === 'b' && entry.binding.toolName !== 'Bash') return;
+    const decision = match[2] === 'b' ? 'allow_bash_until_restart'
+      : match[2] === 'a' ? 'allow' : 'deny';
+    this.settle(match[1], decision, event);
+  }
+
+  private settle(nonce: string, decision: 'allow' | 'deny' | 'allow_bash_until_restart', actor: ProtectedCallback | null): void {
+    const entry = this.#pending.get(nonce);
+    if (!entry) return;
+    this.#pending.delete(nonce);
+    clearTimeout(entry.timer);
+    entry.settledLabel = decision === 'allow_bash_until_restart' ? 'Bash allowed until restart'
+      : decision === 'allow' ? 'Allowed once' : actor ? 'Denied' : 'Closed without approval';
+    this.retireCard(entry);
+    entry.resolve({ kind: 'hub.permission.result', decision, epoch: this.epoch,
+      payload: entry.payload, actor,
+      tag: this.mac(this.cfg.resultKey, 'result', this.epoch, entry.payload, decision, actor) });
+  }
+
+  private retireCard(entry: Pending): void {
+    if (!entry.messageId || !entry.settledLabel) return;
+    try {
+      void this.telegram.settleProtectedCard({ kind: 'card',
+        title: `${entry.settledLabel} · ${entry.title}`, body: entry.body,
+      }, this.cfg.chatId, entry.messageId).catch(() => undefined);
+    } catch { /* Cosmetic failure must not delay or change the permission receipt. */ }
+  }
+
+  close(): void {
+    if (this.#closed) return;
+    this.#closed = true;
+    this.telegram.onProtectedCallback(null);
+    this.telegram.onProtectedDisconnect(null);
+    for (const nonce of this.#pending.keys()) this.settle(nonce, 'deny', null);
+  }
+}
