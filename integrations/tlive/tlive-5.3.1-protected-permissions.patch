+// Additive, private Hub permission channel. The public IMAdapter is unchanged.
+import type { IMAdapter, OutgoingMessage } from './im-adapter.js';
+
+export interface ProtectedCallback {
+  callbackId: string;
+  userId: string;
+  isBot: boolean;
+  chatId: string;
+  chatType: string;
+  messageId: string;
+  data: string;
+}
+
+export interface ProtectedTelegram extends IMAdapter {
+  onProtectedCallback(handler: ((event: ProtectedCallback) => void) | null): void;
+  onProtectedDisconnect(handler: (() => void) | null): void;
+  sendProtectedCard(out: Extract<OutgoingMessage, { kind: 'card' }>, chatId: string): Promise<{ messageId: string }>;
+}
+
+export interface ProtectedBinding {
+  version: 1;
+  requestNonce: string;
+  jobId: string;
+  sessionId: string;
+  generation: number;
+  rootDigest: string;
+  leaseId: string;
+  launchEpoch: string;
+  writer: 'telegram';
+  toolName: 'Read' | 'Glob' | 'Grep' | 'Write' | 'Edit';
+  input: Record<string, unknown>;
+  expiresAt: number;
+}
+
+export type ProtectedRequest =
+  | { kind: 'hub.permission.hello'; version: number; challenge: string }
+  | { kind: 'hub.permission.request'; epoch: string; payload: string; tag: string };
+
+export type ProtectedResponse =
+  | { kind: 'hub.permission.capability'; version: 1; epoch: string; tag: string }
+  | { kind: 'hub.permission.result'; decision: 'allow' | 'deny'; epoch?: string;
+      payload?: string; actor?: ProtectedCallback | null; tag?: string };
