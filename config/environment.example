# Shared by agents-projects-hub.service and the Hermes gateway drop-in.
# Must be the import root of the same clean immutable release used by Hub.
# Resolve its Python purelib path; never point a production plugin at a checkout.
HERMES_PROJECT_HUB_SOURCE=/home/example/.local/share/agents-projects-hub/releases/RELEASE/venv/lib/python3.12/site-packages
HERMES_PROJECT_HUB_STATE=/home/example/.local/state/agents-projects-hub/state.db
HERMES_PROJECT_HUB_OWNER_IDS=123456789
# Used by the optional repository-provided tlive.service.
PATH=/home/example/.local/bin:/home/example/.nvm/versions/node/current/bin:/usr/local/bin:/usr/bin:/bin
