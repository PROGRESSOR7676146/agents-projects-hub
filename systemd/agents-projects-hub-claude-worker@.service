[Unit]
Description=Agents Projects Hub Claude worker slot %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/agents-projects-hub/venv/bin/agents-projects-hub worker %h/.config/agents-projects-hub/hub.json --agent claude --slot %i
EnvironmentFile=-%h/.config/agents-projects-hub/environment
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
# Keep the trusted parent in the host UID namespace for immutable-runtime
# ownership validation. The model itself is isolated by the bubblewrap launcher.
PrivateTmp=false
PrivateUsers=false

[Install]
WantedBy=default.target
