[Unit]
Description=Agents Projects Hub project-group provisioner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/agents-projects-hub/venv/bin/agents-projects-hub project-provisioner %h/.config/agents-projects-hub/hub.json
EnvironmentFile=-%h/.config/agents-projects-hub/environment
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
