[Unit]
Description=tlive Telegram monitoring and Codex remote approvals
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/agents-projects-hub/environment
ExecStart=/usr/bin/env tlive start --foreground
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# The Codex daemon serves its app-server socket from /tmp/codex-daemon-UID;
# PrivateTmp would hide it and silently force the stdio fallback.
BindPaths=-/tmp/codex-daemon-%U

[Install]
WantedBy=default.target
