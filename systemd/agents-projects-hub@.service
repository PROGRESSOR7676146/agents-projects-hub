[Unit]
Description=Agents Projects Hub agent %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/agents-projects-hub/venv/bin/agents-projects-hub serve %h/.config/agents-projects-hub/hub.json --agent %i
EnvironmentFile=-%h/.config/agents-projects-hub/environment
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# The Codex daemon serves its app-server socket from /tmp/codex-daemon-UID;
# PrivateTmp would hide it and silently force the stdio fallback.
BindPaths=-/tmp/codex-daemon-%U

[Install]
WantedBy=default.target
